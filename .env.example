# Optional: Ohne .env gelten genau diese Werte als Standard.
# Kopiere die Datei nur nach .env, wenn du etwas ändern willst.

# Toggle RSS offline/online mode
# Set to "true" for offline (use static feed), "false" for online (fetch live RSS)
RSS_OFFLINE_MODE=true

# Test credentials for authentication (read by the Playwright tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password

# Secret key for Auth.js v5 (used for signing tokens, etc.).
# Optional in dev: without it auth.config.ts uses a fixed dev fallback.
# Changing it invalidates existing session cookies ("no matching decryption secret").
# AUTH_SECRET=change-me