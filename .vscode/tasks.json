        {
            "label": "Playwright: Run Tests (MS Edge)",
            "type": "shell",
            "command": "dotnet",
            "args": ["test", "--settings", "msedge.runsettings"],
            "group": "test",
            "options": {
                "cwd": "${workspaceFolder}/PlaywrightTests"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}