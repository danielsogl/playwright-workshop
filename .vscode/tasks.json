                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Playwright: Run Tests (WebKit)",
            "type": "shell",
            "command": "dotnet",
            "args": ["test", "--settings", "webkit.runsettings"],
            "group": "test",
            "options": {
